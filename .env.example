# =========================================================
# xiaohugochat 部署配置示例
# 用法：复制为 .env 后按需修改（.env 不会提交到 git）
#   cp .env.example .env
# =========================================================

# ---------- 应用 ----------
# 对外访问端口（服务器上一般用 8080；若被占用改成别的，如 8081）
APP_PORT=8080
# 镜像 tag
TAG=latest
# 构建目标：app-with-blog（含博客）| app（不含博客，构建更快）
BUILD_TARGET=app-with-blog
# 基础镜像源：中国大陆服务器若拉不到 Docker Hub，用下面这行加速
# REGISTRY=docker.m.daocloud.io/library
REGISTRY=docker.io/library

# ---------- 安全（部署前必须改） ----------
# JWT 签名密钥：随便敲 40 位以上随机字符，别用默认值
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_ACCESS_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_HOURS=720

# ---------- MySQL ----------
MYSQL_IMAGE=mysql:8.0
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=gochat
MYSQL_USER=gochat
MYSQL_PASSWORD=gochat123

# ---------- Redis ----------
REDIS_IMAGE=redis:7-alpine

# ---------- RabbitMQ ----------
RABBITMQ_IMAGE=rabbitmq:3-management
RABBITMQ_USER=gochat
RABBITMQ_PASSWORD=gochat123

# ---------- WebRTC 语音通话 ----------
# 消息功能不需要这些；只有「跨设备打电话」才需要。
# 注意：浏览器只在 HTTPS（或 localhost）下允许采集麦克风，
#       所以跨设备通话必须先用 Nginx 配好 HTTPS，详见 DEPLOY.md 第八节。
# STUN：发现公网地址，多数家用宽带可直连
RTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun.miwifi.com:3478,stun:stun.qq.com:3478
# TURN：对称 NAT / 4G 网络必需（打洞失败时中继），不填则只用 STUN
# RTC_TURN_URL=turn:chat.example.com:3478
# RTC_TURN_USER=gochat
# RTC_TURN_PASS=change-me

# 注：MySQL/Redis/RabbitMQ 的端口默认不对外暴露，只在容器网络内互通。
# 需要在宿主机调试时，可临时加 ports 映射，或直接用：
#   docker compose exec mysql mysql -uroot -p
#   docker compose exec redis redis-cli
